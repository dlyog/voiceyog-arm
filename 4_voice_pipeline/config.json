      0.5,
      0.9
    ],
    "eps": 1e-09,
    "lr_decay": 0.999875,
    "c_mel": 45,
    "c_kl": 1.0,
    "bf16": true,
    "log_every": 50,
    "save_every_epochs": 1,
    "val_sentences": "tts/eval_sentences.txt",
    "val_every_epochs": 10,
    "whisper_url": "http://127.0.0.1:8007/v1/audio/transcriptions",
    "keep_best_checkpoints": 10
  }
