{
  "data": {
    "csv_path": "output/kokoro/metadata.csv",
    "audio_dir": "output/kokoro/wavs",
    "phoneme_config": "tts_config.json",
    "cache_dir": "runs/cache",
    "sample_rate": 24000,
    "filter_length": 1024,
